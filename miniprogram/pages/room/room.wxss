}

.city-meta text {
  padding: 6rpx 10rpx;
  border-radius: 6rpx;
  background: rgba(255, 248, 232, 0.82);
  border: 1rpx solid rgba(185, 130, 60, 0.55);
}

.city-list-note {
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  border-radius: 8rpx;
