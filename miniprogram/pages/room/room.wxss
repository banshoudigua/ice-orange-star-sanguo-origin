  font-size: 23rpx;
  line-height: 1.45;
}

.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 30;
  padding: 40rpx 28rpx;
  box-sizing: border-box;
  background: rgba(31, 18, 10, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
}

.character-mask {
  z-index: 42;
}

.event-modal,
.player-modal,
.city-modal,
.attack-modal,
.character-modal,
.victory-modal,
.settlement-modal {
  position: relative;
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  box-sizing: border-box;
  padding: 24rpx;
  border-radius: 12rpx;
  background: #fff4d4;
  border: 4rpx solid #d5a452;
  animation: modalRise 260ms ease both;
}

.movement-float {
  position: fixed;
  left: 0;
  right: 0;
  top: 34%;
  z-index: 38;
  display: flex;
  justify-content: center;
  pointer-events: none;
}

.movement-card {
  min-width: 360rpx;
  padding: 26rpx 34rpx;
  border-radius: 12rpx;
  background:
    radial-gradient(circle at 50% 0%, rgba(255, 237, 172, 0.34), transparent 54%),
    linear-gradient(180deg, #8a5a28, #442511);
  border: 4rpx solid #d5a452;
  box-shadow: 0 18rpx 48rpx rgba(31, 18, 10, 0.28);
  text-align: center;
  animation: moveStepRise 1800ms ease both;
}

.movement-dice {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto 12rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  background: #fff8e8;
  border: 4rpx solid #bd8a42;
  color: #7d2c18;
  font-size: 42rpx;
  font-weight: 900;
}

.movement-text {
  color: #fff4bf;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.2;
}

.card-effect-float {
  position: fixed;
  left: 0;
  right: 0;
  top: 24%;
  z-index: 43;
  display: flex;
  justify-content: center;
  pointer-events: none;
}

.card-effect-burst {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 520rpx;
  height: 520rpx;
  margin-left: -260rpx;
  margin-top: -260rpx;
  border-radius: 50%;
  background:
    radial-gradient(circle, rgba(255, 244, 191, 0.52) 0%, rgba(213, 164, 82, 0.18) 42%, rgba(213, 164, 82, 0) 68%),
    conic-gradient(rgba(255, 244, 191, 0), rgba(255, 244, 191, 0.78), rgba(255, 244, 191, 0));
  animation: cardEffectBurst 2300ms ease both;
}

.card-effect-card {
  position: relative;
  display: flex;
  align-items: center;
  width: 640rpx;
  min-height: 188rpx;
  padding: 18rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background:
    radial-gradient(circle at 24% 18%, rgba(255, 244, 191, 0.32), transparent 44%),
    linear-gradient(135deg, #fff6d9, #e5bf6a 54%, #8a5a28);
  border: 4rpx solid #fff0b8;
  box-shadow: 0 24rpx 60rpx rgba(31, 18, 10, 0.34);
  animation: cardEffectPop 2300ms ease both;
}

.card-effect-art {
  flex: none;
  width: 150rpx;
  height: 150rpx;
  border-radius: 10rpx;
  background: #ead6a5;
  border: 3rpx solid #7d2c18;
  box-shadow: 0 8rpx 22rpx rgba(95, 49, 18, 0.24);
}

.card-effect-info {
  min-width: 0;
  flex: 1;
  margin-left: 18rpx;
}

.card-effect-kicker {
  display: inline-block;
  padding: 5rpx 10rpx;
  border-radius: 6rpx;
  color: #fff6da;
  background: #1f563f;
  font-size: 21rpx;
  font-weight: 900;
}

.card-effect-name {
  margin-top: 8rpx;
  color: #7d2c18;
  font-size: 38rpx;
  line-height: 1.12;
  font-weight: 900;
}

.card-effect-title {
  margin-top: 6rpx;
  color: #4a2c17;
  font-size: 27rpx;
  line-height: 1.25;
  font-weight: 900;
}

.card-effect-desc {
  margin-top: 6rpx;
  color: #5a2d16;
  font-size: 22rpx;
  line-height: 1.35;
