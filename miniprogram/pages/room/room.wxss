@keyframes diceShake {
  0% { transform: rotate(0deg) scale(1); }
  18% { transform: rotate(16deg) scale(1.08); }
  36% { transform: rotate(-18deg) scale(0.96); }
  54% { transform: rotate(12deg) scale(1.08); }
  72% { transform: rotate(-8deg) scale(1.02); }
  100% { transform: rotate(0deg) scale(1); }
}

@keyframes dicePanelPulse {
  0% { box-shadow: 0 0 0 rgba(213, 164, 82, 0); }
  45% { box-shadow: 0 0 32rpx rgba(213, 164, 82, 0.8); }
  100% { box-shadow: 0 0 0 rgba(213, 164, 82, 0); }
}

@keyframes modalRise {
  from { opacity: 0; transform: translateY(36rpx) scale(0.96); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes raysSpin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes winnerPop {
  0% { transform: scale(0.72); opacity: 0; }
  58% { transform: scale(1.08); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

@keyframes confettiDrop {
  0% { transform: translateY(-18rpx) rotate(0deg); opacity: 0; }
  30% { opacity: 0.9; }
  100% { transform: translateY(52rpx) rotate(190deg); opacity: 0; }
}

@keyframes cardRewardPop {
  0% { opacity: 0; transform: translateY(24rpx) scale(0.92); }
  68% { opacity: 1; transform: translateY(-4rpx) scale(1.03); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes moveStepRise {
  0% { opacity: 0; transform: translateY(46rpx) scale(0.9); }
  22% { opacity: 1; transform: translateY(0) scale(1.05); }
  72% { opacity: 1; transform: translateY(-8rpx) scale(1); }
  100% { opacity: 0; transform: translateY(-34rpx) scale(0.96); }
}

@keyframes cardEffectPop {
  0% { opacity: 0; transform: translateY(52rpx) scale(0.78) rotate(-2deg); }
  18% { opacity: 1; transform: translateY(0) scale(1.05) rotate(1deg); }
  36% { transform: translateY(-8rpx) scale(1) rotate(0deg); }
  78% { opacity: 1; transform: translateY(-8rpx) scale(1); }
  100% { opacity: 0; transform: translateY(-42rpx) scale(0.94); }
}

@keyframes cardEffectBurst {
  0% { opacity: 0; transform: scale(0.42) rotate(0deg); }
  18% { opacity: 0.95; transform: scale(0.86) rotate(18deg); }
  66% { opacity: 0.42; transform: scale(1.16) rotate(120deg); }
  100% { opacity: 0; transform: scale(1.28) rotate(180deg); }
}

@keyframes attackPulse {
  0% { transform: scale(0.99); filter: brightness(0.98); }
  50% { transform: scale(1.015); filter: brightness(1.08); }
  100% { transform: scale(0.99); filter: brightness(0.98); }
}

.count-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.count-chip {
  min-width: 112rpx;
  padding: 16rpx 20rpx;
  text-align: center;
  border-radius: 8rpx;
  color: #fff6da;
  background: linear-gradient(180deg, #d59d44, #996229);
  border: 2rpx solid #f2c875;
  font-size: 28rpx;
  font-weight: 700;
}
