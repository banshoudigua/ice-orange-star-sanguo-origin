  color: #4a2c17;
  font-size: 27rpx;
  line-height: 1.58;
}

.settlement-card {
  margin-top: 14rpx;
  padding: 16rpx;
  border-radius: 8rpx;
  background: #fff8e8;
  border: 2rpx solid #c99445;
