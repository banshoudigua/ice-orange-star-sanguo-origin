@import "../events/events.wxss";

.city-detail-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 40;
  padding: 40rpx 28rpx;
  box-sizing: border-box;
  background: rgba(31, 18, 10, 0.74);
  display: flex;
  align-items: center;
  justify-content: center;
}

.city-detail-card {
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  box-sizing: border-box;
  padding: 24rpx;
  border-radius: 12rpx;
  background: #fff4d4;
  border: 4rpx solid #d5a452;
  animation: cityDetailRise 260ms ease both;
}

.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.close-btn {
  flex: none;
}

.city-detail-art {
  display: block;
  width: 100%;
  height: auto;
  margin-bottom: 16rpx;
  border-radius: 10rpx;
  background: #ead6a5;
  border: 2rpx solid #70401e;
}

.city-detail-meta {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10rpx;
  margin-top: 12rpx;
}

.city-detail-meta view {
  min-width: 0;
  padding: 12rpx;
  border-radius: 8rpx;
  background: #f8e9c2;
  border: 1rpx solid rgba(185, 130, 60, 0.58);
}

.city-detail-meta text {
  display: block;
  color: #765537;
  font-size: 22rpx;
}

.city-detail-meta strong {
  display: block;
  margin-top: 4rpx;
  color: #4a2c17;
  font-size: 27rpx;
  font-weight: 900;
}

.city-detail-section {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 8rpx;
  background: #fff8e8;
  border: 2rpx solid rgba(185, 130, 60, 0.55);
}

.detail-section-title {
  color: #7d2c18;
  font-size: 27rpx;
  font-weight: 900;
}

.detail-copy {
  margin-top: 10rpx;
  color: #4a2c17;
  font-size: 25rpx;
  line-height: 1.58;
}

.city-detail-actions {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}

.city-detail-actions-top {
  margin-top: 12rpx;
  margin-bottom: 16rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid rgba(185, 130, 60, 0.42);
}

.city-detail-actions .btn {
  width: 100%;
  margin: 0;
}

@keyframes cityDetailRise {
  from { opacity: 0; transform: translateY(36rpx) scale(0.96); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
