.counts {
  margin: 16rpx 0;
  color: #473526;
  font-size: 26rpx;
}

.big-percent {
  font-size: 56rpx;
  font-weight: 900;
  color: #7d2c18;
}

.name {
  font-size: 30rpx;
  font-weight: 700;
  color: #7d2c18;
}

.preview {
  width: 150rpx;
  height: 112rpx;
  border-radius: 8rpx;
  background: #ead6a5;
  flex: none;
}

.batch-row,
.task-card {
  display: flex;
  align-items: center;
  margin: 0 20rpx 16rpx;
  padding: 18rpx;
  border-radius: 10rpx;
  background: #f2d9a7;
  border: 2rpx solid #9e6a2f;
}

.batch-main,
.task-main {
  flex: 1;
  margin-left: 16rpx;
}

.retry {
  margin-top: 12rpx;
}

.prompt-copy {
  margin-top: 10rpx;
  color: #4d3927;
  font-size: 23rpx;
  line-height: 1.45;
}
