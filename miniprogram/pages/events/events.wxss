.type-tabs {
  box-sizing: border-box;
  width: 100%;
  white-space: nowrap;
  padding: 0 20rpx 18rpx;
}

.type-tab {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  min-height: 58rpx;
  padding: 0 20rpx;
  margin-right: 12rpx;
  border-radius: 8rpx;
  color: #72502a;
  background: #fff1c7;
  border: 2rpx solid #ddb05d;
  font-size: 26rpx;
  font-weight: 700;
}

.type-tab.active {
  color: #fff9dd;
  background: linear-gradient(180deg, #e45c33, #b83722);
  border-color: #ffd575;
}

.type-count {
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  border-radius: 17rpx;
  color: #8c5424;
  background: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  line-height: 34rpx;
  text-align: center;
}

.event-focus {
  margin: 0 20rpx 18rpx;
  padding: 22rpx;
  border-radius: 10rpx;
  background: linear-gradient(180deg, #fff4c6, #f6c875 52%, #e88c46);
  border: 3rpx solid #f4cf65;
  color: #56331e;
  box-shadow: 0 12rpx 24rpx rgba(126, 68, 25, 0.18);
}

.event-focus .title {
  color: #7d2c18;
}

.event-focus .subtle {
  color: #81552e;
}

.event-seal {
  width: 96rpx;
  height: 44rpx;
  text-align: center;
  border-radius: 6rpx;
  color: #fbeab5;
  background: #a6341b;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.focus-tag {
  margin-bottom: 10rpx;
}

.event-art {
  position: relative;
  overflow: hidden;
  width: 100%;
  aspect-ratio: 1 / 1;
  height: calc(100vw - 104rpx);
  max-height: 650rpx;
  margin-bottom: 14rpx;
  border-radius: 8rpx;
  background: linear-gradient(180deg, #fff1c2, #d7994a);
  border: 2rpx solid #f3c052;
}

.event-art.large {
  width: 100%;
  margin-bottom: 16rpx;
  border-width: 3rpx;
}

.event-art::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background:
    linear-gradient(135deg, rgba(255, 245, 155, 0.22), rgba(92, 207, 255, 0.16) 48%, rgba(255, 136, 91, 0.2)),
    radial-gradient(circle at 24% 18%, rgba(255, 255, 255, 0.38), transparent 32%);
  pointer-events: none;
}

.event-cover,
.event-thumb {
  width: 100%;
  height: 100%;
  display: block;
  filter: brightness(1.08) saturate(1.18) contrast(0.98);
}

.name {
  font-size: 30rpx;
  font-weight: 700;
  color: #7d2c18;
}

.desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #473526;
}

.event-desc,
.event-action {
  margin-top: 14rpx;
  padding: 16rpx;
  border-radius: 8rpx;
  background: rgba(255, 249, 221, 0.68);
  border: 1rpx solid rgba(185, 103, 42, 0.25);
}

.event-board {
  padding: 0 20rpx 24rpx;
}

.event-card {
  padding: 20rpx;
  margin-bottom: 16rpx;
  border-radius: 10rpx;
  background: linear-gradient(180deg, #fff4cc, #f5cf80);
  border: 2rpx solid #c98335;
  box-shadow: 0 8rpx 16rpx rgba(137, 76, 31, 0.12);
}
