<view class="page page-events" style="{{pageBackgroundStyle}}">
  <view class="stage">
    <view class="top-plaque">
      <view class="row">
        <view>
          <view class="title">{{labels.event || '事件卡'}}一览</view>
          <view class="subtle">{{theme.title}} · {{events.length}} 张内容 · 按类型浏览</view>
        </view>
        <button class="btn light compact" bindtap="randomEvent">随机</button>
      </view>
    </view>
    <scroll-view class="type-tabs" scroll-x>
      <view
        wx:for="{{eventTypes}}"
        wx:key="name"
        class="type-tab {{activeType === item.name ? 'active' : ''}}"
        data-type="{{item.name}}"
        bindtap="selectType"
      >
        <text>{{item.name}}</text>
        <text class="type-count">{{item.count}}</text>
      </view>
    </scroll-view>
    <view class="event-focus" wx:if="{{current}}">
      <view class="event-art large" wx:if="{{current.preview}}">
        <image class="event-cover" src="{{current.preview}}" mode="aspectFit" />
      </view>
      <view class="event-seal">{{current.rarity}}</view>
      <view class="tag focus-tag">{{current.event_type}}</view>
      <view class="title small">{{current.title}}</view>
      <view class="subtle">{{current.trigger_condition}}</view>
      <view class="event-desc">{{current.effect_desc}}</view>
      <view class="event-action">{{current.board_action}}</view>
    </view>
    <view class="event-board">
      <view class="event-card" wx:for="{{filteredEvents}}" wx:key="id" data-index="{{index}}" bindtap="selectEvent">
        <view class="event-art" wx:if="{{item.preview}}">
          <image class="event-thumb" src="{{item.preview}}" mode="aspectFit" />
        </view>
        <view class="row">
          <view class="name">{{item.title}}</view>
          <view class="tag">{{item.event_type}}</view>
        </view>
        <view class="subtle">{{item.rarity}} · {{item.trigger_condition}}</view>
        <view class="desc">{{item.effect_desc}}</view>
      </view>
    </view>
  </view>
</view>
