.page-map {
  min-height: 100vh;
  background:
    linear-gradient(180deg, rgba(48, 22, 11, 0.38), rgba(216, 172, 91, 0.26)),
    linear-gradient(180deg, #7a371b 0%, #8a4f24 54%, #d0a15f 100%);
}

.map-stage {
  width: 100%;
  min-height: calc(100vh - 44rpx);
  padding-bottom: 42rpx;
  box-sizing: border-box;
  background:
    linear-gradient(180deg, rgba(255, 248, 222, 0.94) 0%, rgba(236, 208, 151, 0.48) 76%, rgba(236, 208, 151, 0.2) 100%);
}

.map-hero {
  margin-bottom: 16rpx;
}

.map-theme-tabs {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin: 0 20rpx 18rpx;
}

.map-theme-tab {
  min-width: 0;
  min-height: 92rpx;
  padding: 12rpx 14rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  color: #3a210d;
  background: #ecd29a;
  border: 2rpx solid rgba(185, 130, 60, 0.82);
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.26), 0 8rpx 16rpx rgba(69, 38, 13, 0.1);
}

.map-theme-tab.active {
  color: #fff2d0;
  background: linear-gradient(180deg, #50714a, #244e2f);
  border-color: #e7bd66;
}

.map-theme-title {
  font-size: 26rpx;
  line-height: 1.25;
  font-weight: 900;
}

.map-theme-sub {
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.3;
  opacity: 0.86;
}

.map-viewer-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.map-preview-main {
  flex: 1;
  min-width: 0;
}

.map-preview-label {
  color: #7b542f;
  font-size: 21rpx;
  font-weight: 900;
}

.map-preview-title {
  margin-top: 4rpx;
  color: #3a210d;
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 900;
}

.map-preview-desc {
  margin-top: 8rpx;
  color: #6b431f;
  font-size: 22rpx;
  line-height: 1.45;
}

.map-close-btn {
  width: 132rpx;
  height: 62rpx;
  flex: none;
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  color: #fff4cb;
  background: linear-gradient(180deg, #8d361e, #592011);
  border: 0;
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.map-close-btn::after {
  border: 0;
}

.map-toolbar {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-bottom: 14rpx;
  width: 100%;
  box-sizing: border-box;
}

.map-tool-btn {
  width: 100%;
  min-width: 0;
  min-height: 60rpx;
  margin: 0;
  padding: 0 6rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  color: #fff2d0;
  background: linear-gradient(180deg, #50714a, #244e2f);
  border: 0;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.2 !important;
  text-align: center;
  overflow: visible;
  word-break: keep-all;
  white-space: normal;
  display: flex;
  align-items: center;
  justify-content: center;
}

.map-tool-btn:nth-child(4) {
  grid-column: 1 / 2;
}

.map-tool-btn:nth-child(5) {
  grid-column: 2 / 4;
}

.map-tool-btn.light {
  color: #3b230f;
  background: linear-gradient(180deg, #e7bd66, #a96a27);
}

.map-tool-btn.secondary {
  color: #fff2d0;
  background: linear-gradient(180deg, #95612e, #6b3e18);
}

.map-tool-btn.primary {
  color: #fff4cb;
  background: linear-gradient(180deg, #8d361e, #592011);
}

.map-option-panel {
  margin-bottom: 18rpx;
}

.map-option-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.map-option-note {
  margin-top: 6rpx;
  color: #765537;
  font-size: 22rpx;
}

.map-option-count {
  min-width: 72rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  color: #fff1c8;
  background: #5a2d16;
  font-size: 21rpx;
  font-weight: 900;
  text-align: center;
}

.map-card-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 16rpx;
}

.map-option-card {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 12rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  background: #ecd29a;
  border: 2rpx solid #bd8a42;
  white-space: normal;
  box-shadow: 0 8rpx 16rpx rgba(69, 38, 13, 0.1);
}

.map-option-card.active {
  background: #f5dfad;
  border-color: #2e6f4f;
  box-shadow: inset 0 0 0 2rpx rgba(46, 111, 79, 0.18);
}

.map-option-thumb {
  width: 100%;
  height: 150rpx;
  border-radius: 8rpx;
  background: #d2a45a;
  border: 1rpx solid #8a4d22;
}

.map-option-main {
  flex: 1;
  min-width: 0;
}

.map-option-title {
  color: #3a210d;
  font-size: 25rpx;
  line-height: 1.25;
  font-weight: 900;
}

.map-option-desc {
  margin-top: 6rpx;
  color: #70451e;
  font-size: 20rpx;
  line-height: 1.35;
}

.map-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid rgba(138, 77, 34, 0.26);
}

.map-card-status {
  color: #2e6f4f;
  font-size: 21rpx;
  font-weight: 800;
}

.map-card-arrow {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  color: #fff2d0;
  background: #5a2d16;
  font-size: 32rpx;
  line-height: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.map-area {
  width: 100%;
  height: 820rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: rgba(255, 244, 214, 0.9);
  border: 2rpx solid rgba(164, 112, 36, 0.45);
}

.map-view {
  width: 100%;
  min-height: 820rpx;
}

.map-image {
  width: 100%;
}

.map-tips {
  margin-top: 18rpx;
}

.map-tip-copy {
  margin-top: 10rpx;
  color: #5a3e21;
  font-size: 24rpx;
  line-height: 1.6;
}

.map-viewer-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 50;
  padding: 32rpx 22rpx;
  box-sizing: border-box;
  background: rgba(31, 18, 10, 0.76);
  display: flex;
  align-items: center;
  justify-content: center;
}

.map-viewer {
  width: 100%;
  max-height: 92vh;
  padding: 18rpx;
  box-sizing: border-box;
  border-radius: 10rpx;
  background: #fff1c8;
  border: 4rpx solid #d5a452;
  overflow: hidden;
}
